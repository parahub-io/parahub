[Unit]
Description=Parahub Frontend (Nuxt 3)
After=network.target

[Service]
Type=simple
User=norn
Group=norn
WorkingDirectory=/opt/parahub/frontend
ExecStart=/usr/bin/node /opt/parahub/frontend/.output/server/index.mjs
Restart=always
RestartSec=10

# Environment variables
Environment="NODE_ENV=production"
Environment="NITRO_PORT=3000"
Environment="NITRO_HOST=0.0.0.0"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parahub-frontend

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5

# Backstop against runaway RSS (in-process cache growth, native bloat):
# reclaim pressure from 5G, hard OOM-kill at 8G (Restart=always picks it up).
# Normal RSS is well under 2G.
MemoryHigh=5G
MemoryMax=8G

[Install]
WantedBy=multi-user.target