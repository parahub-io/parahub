[Unit]
Description=Parahub waiting-passenger marker snapshot (municipal history)
After=network.target redis.service postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=norn
WorkingDirectory=/opt/parahub
Environment=DJANGO_SETTINGS_MODULE=parahub.settings
ExecStart=/opt/parahub/venv/bin/python manage.py snapshot_waiting --interval 60
Restart=always
RestartSec=10
SyslogIdentifier=waiting-snapshot

[Install]
WantedBy=multi-user.target
