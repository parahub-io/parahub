{
  "name": "Parahub",
  "short_name": "Parahub",
  "description": "Federated platform for global P2P cooperation, trade and communications",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffe216",
  "theme_color": "#ffe216",
  "related_applications": [
    {
      "platform": "play",
      "id": "io.parahub.app",
      "url": "https://play.google.com/store/apps/details?id=io.parahub.app"
    }
  ],
  "prefer_related_applications": true,
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/logo.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
